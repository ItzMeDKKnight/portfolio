{
  "name": "ansh-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio website of Ansh Anand Mutatkar, Full Stack Developer",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/main.js",
    "watch": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/main.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
